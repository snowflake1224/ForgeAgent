# ForgeAgent configuration — copy to .env and fill in values.
# Never commit real API keys.

FORGE_ENV=development
FORGE_LOG_LEVEL=INFO

# API
FORGE_API_HOST=0.0.0.0
FORGE_API_PORT=8000
FORGE_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite by default for local; use Postgres in production)
FORGE_DATABASE_URL=sqlite+aiosqlite:///./data/forgeagent.db
# FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forgeagent

# Redis (optional; in-memory fallback used when unset/unavailable)
FORGE_REDIS_URL=redis://localhost:6379/0

# LLM provider: mock | openai | anthropic | azure_openai
FORGE_LLM_PROVIDER=mock
FORGE_LLM_MODEL=mock-gpt
FORGE_LLM_API_KEY=
FORGE_LLM_BASE_URL=
FORGE_LLM_MAX_TOKENS=4096
FORGE_LLM_TEMPERATURE=0.0

# Budgets / limits
FORGE_MAX_AGENT_ITERATIONS=12
FORGE_MAX_TOOL_CALLS=80
FORGE_TOKEN_BUDGET=200000
FORGE_TASK_TIMEOUT_SECONDS=1800
FORGE_CONTEXT_BUDGET_TOKENS=32000

# Sandbox
FORGE_SANDBOX_BACKEND=docker
# Use local only for trusted development fixtures; it is not a security boundary.
# FORGE_SANDBOX_BACKEND=local
FORGE_SANDBOX_IMAGE=forgeagent/sandbox:latest
FORGE_SANDBOX_CPU_LIMIT=2.0
FORGE_SANDBOX_MEMORY_LIMIT_MB=2048
FORGE_SANDBOX_TIMEOUT_SECONDS=300
FORGE_SANDBOX_NETWORK_DISABLED=true
FORGE_SANDBOX_ALLOW_LOCAL_FALLBACK=true

# GitHub
FORGE_GITHUB_TOKEN=
FORGE_GITHUB_API_URL=https://api.github.com

# Observability
FORGE_OTEL_ENABLED=true
FORGE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
FORGE_METRICS_ENABLED=true
FORGE_METRICS_PORT=9090

# Claude Code / external coding backend (optional)
FORGE_CLAUDE_CODE_ENABLED=false
FORGE_CLAUDE_CODE_COMMAND=claude
FORGE_CLAUDE_CODE_WORKDIR=

# Security
FORGE_TOOL_POLICY_DEFAULT=deny
FORGE_ALLOWED_TOOL_PREFIXES=repo.,fs.,git.,issue.,test.,static.,docs.,inspect.
FORGE_SECRETS_REDACTION_ENABLED=true

# Local persistence paths
FORGE_DATA_DIR=./data
FORGE_ARTIFACTS_DIR=./artifacts
FORGE_RUNS_DIR=./runs
